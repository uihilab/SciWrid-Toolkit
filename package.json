{
  "name": "webparsers",
  "version": "0.1.0",
  "description": "Pure-C WASM library for parsing meteorological data formats (GRIB2, NetCDF, etc.) in the browser",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./wasm": "./wasm/webparsers.js",
    "./wasm-binary": "./wasm/webparsers.wasm",
    "./worker": "./worker/loader.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/webparsers-lib.js",
    "lib/webparsers-api.js",
    "lib/webparsers-api.d.ts",
    "lib/zarr-helper.js",
    "lib/zarr/zip.js",
    "lib/zarr/decompressors.js",
    "lib/zarr/filters.js",
    "lib/zarr/metadata.js",
    "lib/zarr/chunk-grid.js",
    "lib/tiff-helper.js",
    "lib/tiff/errors.js",
    "lib/tiff/ifd-reader.js",
    "lib/tiff/geokeys.js",
    "lib/tiff/projections.js",
    "lib/tiff/tile-index.js",
    "lib/tiff/sample-decoder.js",
    "lib/tiff/predictors.js",
    "lib/tiff/decoders/none.js",
    "lib/tiff/decoders/deflate.js",
    "lib/tiff/decoders/lzw.js",
    "lib/grid-output.js",
    "lib/kerchunk-helper.js",
    "lib/kerchunk/parquet-refs.js",
    "lib/kerchunk/ref-store.js",
    "lib/slim/index.js",
    "lib/slim/byte-source.js",
    "lib/slim/errors.js",
    "lib/slim/grib2.js",
    "lib/slim/netcdf3.js",
    "lib/slim/zarr.js",
    "lib/slim/netcdf4.js",
    "wasm/webparsers.js",
    "wasm/webparsers.wasm",
    "worker/worker.js",
    "worker/loader.js",
    "README.md"
  ],
  "keywords": [
    "grib2",
    "netcdf",
    "meteorology",
    "weather",
    "wasm",
    "noaa",
    "hrrr",
    "gfs"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "h5wasm": "^0.7.7",
    "hyparquet": "^1.10.0",
    "jpeg-js": "^0.4.4",
    "numcodecs": "^0.3.2"
  },
  "devDependencies": {
    "hyparquet-writer": "^0.15.1",
    "pngjs": "^7.0.0"
  },
  "scripts": {
    "demo:grib2": "node examples/testfile/demoGrib2File.js",
    "demo:netcdf3": "node examples/testfile/demoNetcdf3File.js",
    "demo:netcdf4": "node examples/testfile/demoNetcdf4File.js",
    "demo:zarr": "node examples/testfile/demoZarrFile.js",
    "demo:web": "node scripts/serve.js",
    "build:wasm": "python wasm/build.py",
    "build:tiff-fixtures": "node scripts/build-tiff-fixtures.js",
    "test:api": "node scripts/test-api.js",
    "test:grid": "node scripts/test-grid.js",
    "test:zarr": "node scripts/test-zarr.js",
    "test:kerchunk": "node scripts/test-kerchunk.js",
    "test:slim": "node scripts/test-slim.js",
    "test:tiff": "node scripts/test-tiff.js",
    "test:tiff-range": "node scripts/test-tiff-range.js",
    "test:time": "node scripts/test-time.js",
    "test:render": "node scripts/test-render.js"
  },
  "engines": {
    "node": ">=18"
  }
}

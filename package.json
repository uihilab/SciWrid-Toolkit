{
  "name": "webparsers",
  "version": "0.1.0",
  "description": "WebAssembly library for parsing meteorological and geospatial data formats (GRIB2, NetCDF3, NetCDF4/HDF5, Zarr v2, TIFF/GeoTIFF) in the browser, Web Workers, and Node.js",
  "type": "module",
  "author": "Khoa Le <dle5@tulane.edu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uihilab/webparsers.git"
  },
  "homepage": "https://github.com/uihilab/webparsers#readme",
  "bugs": {
    "url": "https://github.com/uihilab/webparsers/issues"
  },
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./wasm": "./wasm/webparsers.js",
    "./wasm-binary": "./wasm/webparsers.wasm",
    "./worker": "./worker/loader.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/webparsers-lib.js",
    "lib/webparsers-api.js",
    "lib/webparsers-api.d.ts",
    "lib/errors.js",
    "lib/time-decoder.js",
    "lib/time-select.js",
    "lib/zarr-helper.js",
    "lib/zarr/zip.js",
    "lib/zarr/decompressors.js",
    "lib/zarr/filters.js",
    "lib/zarr/metadata.js",
    "lib/zarr/chunk-grid.js",
    "lib/tiff-helper.js",
    "lib/tiff/errors.js",
    "lib/tiff/ifd-reader.js",
    "lib/tiff/geokeys.js",
    "lib/tiff/projections.js",
    "lib/tiff/tile-index.js",
    "lib/tiff/sample-decoder.js",
    "lib/tiff/predictors.js",
    "lib/tiff/decoders/none.js",
    "lib/tiff/decoders/deflate.js",
    "lib/tiff/decoders/lzw.js",
    "lib/tiff/encoders/deflate.js",
    "lib/tiff/encoders/predictor.js",
    "lib/grid-output.js",
    "lib/render/index.js",
    "lib/render/colorramps.js",
    "lib/render/normalize.js",
    "lib/render/to-imagedata.js",
    "lib/render/to-png.js",
    "lib/kerchunk-helper.js",
    "lib/kerchunk/parquet-refs.js",
    "lib/kerchunk/ref-store.js",
    "lib/slim/index.js",
    "lib/slim/byte-source.js",
    "lib/slim/errors.js",
    "lib/slim/slimGrib2.js",
    "lib/slim/slimNetCDF3.js",
    "lib/slim/slimZarr.js",
    "lib/slim/slimNetCDF4.js",
    "lib/slim/slimTiff.js",
    "wasm/webparsers.js",
    "wasm/webparsers.wasm",
    "worker/worker.js",
    "worker/loader.js",
    "README.md"
  ],
  "keywords": [
    "grib2",
    "netcdf",
    "meteorology",
    "weather",
    "wasm",
    "noaa",
    "hrrr",
    "gfs"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "h5wasm": "^0.7.7",
    "hyparquet": "^1.10.0",
    "jpeg-js": "^0.4.4",
    "numcodecs": "^0.3.2"
  },
  "devDependencies": {
    "hyparquet-writer": "^0.15.1",
    "pngjs": "^7.0.0"
  },
  "scripts": {
    "demo:grib2": "node examples/testfile/demoGrib2File.js",
    "demo:netcdf3": "node examples/testfile/demoNetcdf3File.js",
    "demo:netcdf4": "node examples/testfile/demoNetcdf4File.js",
    "demo:zarr": "node examples/testfile/demoZarrFile.js",
    "demo:web": "node scripts/serve.js",
    "build:wasm": "python wasm/build.py",
    "build:tiff-fixtures": "node scripts/build-tiff-fixtures.js",
    "build:zarr-fixture": "node scripts/build-zarr-fixture.js",
    "test:api": "node scripts/test-api.js",
    "test:grid": "node scripts/test-grid.js",
    "test:zarr": "node scripts/test-zarr.js",
    "test:kerchunk": "node scripts/test-kerchunk.js",
    "test:slim": "node scripts/test-slim.js",
    "test:tiff": "node scripts/test-tiff.js",
    "test:tiff-range": "node scripts/test-tiff-range.js",
    "test:time": "node scripts/test-time.js",
    "test:render": "node scripts/test-render.js",
    "test:time-select": "node scripts/test-time-select.js"
  },
  "engines": {
    "node": ">=18"
  }
}

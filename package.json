{
  "name": "sciwrid-toolkit",
  "version": "0.1.0",
  "description": "WebAssembly library for parsing meteorological and geospatial data formats (GRIB2, NetCDF3, NetCDF4/HDF5, Zarr v2, TIFF/GeoTIFF) in the browser, Web Workers, and Node.js",
  "type": "module",
  "author": "Khoa Le <dle5@tulane.edu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uihilab/SciWrid-Toolkit.git"
  },
  "homepage": "https://github.com/uihilab/SciWrid-Toolkit#readme",
  "bugs": {
    "url": "https://github.com/uihilab/SciWrid-Toolkit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./wasm": "./dist/sciwrid.js",
    "./wasm-binary": "./dist/sciwrid.wasm",
    "./worker": "./dist/loader.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "grib2",
    "netcdf",
    "meteorology",
    "weather",
    "wasm",
    "noaa",
    "hrrr",
    "gfs"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "h5wasm": "^0.7.7",
    "hyparquet": "^1.10.0",
    "jpeg-js": "^0.4.4",
    "jsfive": "^0.4.0",
    "numcodecs": "^0.3.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "hyparquet-writer": "^0.15.1",
    "pngjs": "^7.0.0"
  },
  "scripts": {
    "demo:grib2": "node examples/testfile/demoGrib2File.js",
    "demo:netcdf3": "node examples/testfile/demoNetcdf3File.js",
    "demo:netcdf4": "node examples/testfile/demoNetcdf4File.js",
    "demo:zarr": "node examples/testfile/demoZarrFile.js",
    "demo:web": "node scripts/serve.js",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "build:wasm": "python wasm/build.py",
    "build:tiff-fixtures": "node .testkit/build-tiff-fixtures.js",
    "build:zarr-fixture": "node .testkit/build-zarr-fixture.js",
    "build:zarr-v3-fixture": "node .testkit/build-zarr-v3-fixture.js",
    "test": "node .testkit/test-teardown-safety.js && node .testkit/test-api.js && node .testkit/test-grid.js && node .testkit/test-zarr.js && node .testkit/test-tiff.js && node .testkit/test-trim.js && node .testkit/test-time.js && node .testkit/test-render.js && node .testkit/test-kerchunk.js && node .testkit/test-time-select.js && node .testkit/test-kerchunk-cloud.js && node .testkit/test-map-bbox.js && node .testkit/test-zarr-v3.js && node .testkit/test-zarr-time.js && node .testkit/test-parquet.js && node .testkit/test-parquet-range.js && node .testkit/test-map-demo-analysis.js && node .testkit/test-map-demo-whole.js && node .testkit/test-encoding.js && node .testkit/test-map-demo-sources.js && node .testkit/test-idalia.js && node .testkit/test-remote-size.js && node .testkit/test-fastpath-diag.js && node .testkit/test-bundle-browser-safe.js && node .testkit/test-range-parity.js && node .testkit/test-range-profitability.js && node .testkit/test-grib2-bbox.js && node .testkit/test-trim-zarr-v3.js && node .testkit/test-trim-parquet-error.js",
    "test:api": "node .testkit/test-api.js",
    "test:remote-size": "node .testkit/test-remote-size.js",
    "test:fastpath-diag": "node .testkit/test-fastpath-diag.js",
    "test:bundle-safe": "node .testkit/test-bundle-browser-safe.js",
    "test:range-budget": "node .testkit/test-range-budget.js",
    "test:grid": "node .testkit/test-grid.js",
    "test:zarr": "node .testkit/test-zarr.js",
    "test:zarr-v3": "node .testkit/test-zarr-v3.js",
    "test:zarr-time": "node .testkit/test-zarr-time.js",
    "test:kerchunk": "node .testkit/test-kerchunk.js",
    "test:kerchunk-cloud": "node .testkit/test-kerchunk-cloud.js",
    "test:trim": "node .testkit/test-trim.js",
    "test:tiff": "node .testkit/test-tiff.js",
    "test:tiff-range": "node .testkit/test-tiff-range.js",
    "test:range-parity": "node .testkit/test-range-parity.js",
    "test:range-profitability": "node .testkit/test-range-profitability.js",
    "test:time": "node .testkit/test-time.js",
    "test:render": "node .testkit/test-render.js",
    "test:time-select": "node .testkit/test-time-select.js",
    "test:map-bbox": "node .testkit/test-map-bbox.js",
    "test:analysis": "node .testkit/test-map-demo-analysis.js",
    "test:whole": "node .testkit/test-map-demo-whole.js",
    "demo:parquet": "node examples/testfile/demoParquetFile.js",
    "build:parquet-fixture": "node .testkit/build-parquet-fixture.js",
    "test:parquet": "node .testkit/test-parquet.js",
    "test:parquet-range": "node .testkit/test-parquet-range.js",
    "test:encoding": "node .testkit/test-encoding.js",
    "test:sources": "node .testkit/test-map-demo-sources.js",
    "test:idalia": "node .testkit/test-idalia.js",
    "test:teardown": "node .testkit/test-teardown-safety.js",
    "test:trim-errors": "node .testkit/test-trim-zarr-v3.js && node .testkit/test-trim-parquet-error.js",
    "test:grib2-bbox": "node .testkit/test-grib2-bbox.js"
  },
  "engines": {
    "node": ">=18"
  }
}
